generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}

/////**** ENUMS ****/////

enum Mode {
  OPENING
  LIVE
}

enum Scope {
  GLOBAL
  BUSINESS
  BRANCH
}

enum Role {
  ADMIN
  CEO
  MANAGER
  SALES_REPS
  STAFF
  CLEANER
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum Account {
  CASH
  BANK
  INVENTORY
  COGS
  REVENUE
  EXPENSE
  LIABILITIES
  OWNER_CAPITAL
  OWNER_DRAWINGS
  FIXED_ASSETS
  INTER_BRANCH
}

enum AlertType {
  LOW_STOCK
  SUBSCRIPTION
  LIABILITY_DUE
  CASH_VARIANCE
  SYSTEM
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum BusinessStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum SyncEventStatus {
  PENDING
  SYNCED
  FAILED
  DEAD
}

enum SaleStatus {
  completed
  voided
  refunded
}

enum ExpenseStatus {
  recorded
  voided
  reimbursed
}

enum ExpensePaymentMethod {
  cash
  transfer
  card
  other
}
enum PaymentMethod {
  cash
  transfer
  card
  other
}


enum EmployeeRole {
  ADMIN
  CEO
  MANAGER
  SALES_REPS
  STAFF
  CLEANER
}

enum EmploymentStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum EmployeeInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum InvitationDeliveryChannel {
  EMAIL
  SMS
}

enum InvitationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum BillingPlanStatus {
  DRAFT
  PUBLISHED
  RETIRED
  ARCHIVED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum BillingSubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum BillingRequestType {
  NEW
  UPGRADE
  DOWNGRADE
  RENEWAL
}

enum BillingRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BillingEntitlementSource {
  PLAN
  OVERRIDE
}

enum BillingRecordStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BillingInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOIDED
  CANCELLED
}

enum BillingPaymentStatus {
  INITIATED
  PENDING
  CONFIRMED
  FAILED
  REVERSED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum BillingPaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  ABANDONED
}

enum BillingPaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
  BANK
  MOBILE_MONEY
  OTHER
}

enum BillingRefundStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum BillingProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

enum BillingProviderOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REQUIRES_RECONCILIATION
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum BillingEventStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum BillingCommandStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum BillingLeaseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum BillingAuditAction {
  CREATED
  UPDATED
  APPROVED
  REJECTED
  SUSPENDED
  ACTIVATED
  CANCELLED
  REVOKED
  REFUNDED
  OVERRIDE_GRANTED
  OVERRIDE_REVOKED
  MANUAL_ADJUSTMENT
}




enum PlatformUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportMessageVisibility {
  CUSTOMER
  INTERNAL
}

enum SupportAccessStatus {
  REQUESTED
  APPROVED
  DENIED
  ACTIVE
  EXPIRED
  REVOKED
}

enum SupportAccessMode {
  READ_ONLY
  ASSISTED
}

enum PlatformIncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

enum PlatformIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}


/////**** MODELS ****/////

model Business {
  id          String @id

  name        String

  userId      String?
  address     String?

  isOnboarding        Boolean @default(true)
  onboardingCompleted Boolean @default(false)

  status      BusinessStatus @default(ONBOARDING)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  activatedAt DateTime?

  owner User? @relation("BusinessOwner", fields: [userId], references: [id])

  branches      Branch[]
  events        Event[]
  users         User[]
  products      Product[]
  inventories   Inventory[]
  snapshots     Snapshot[]
  alerts        Alert[]
  ledgerEntries LedgerEntry[]
  sale          Sale[]
  expense       Expense[]
  employees                   Employee[]
  employeeInvitations         EmployeeInvitation[]
  employeeCompensations       EmployeeCompensation[]
  employeeCompensationHistory EmployeeCompensationHistory[]
  employeeRequests            EmployeeRequest[]
  employeeNotifications       EmployeeNotification[]

  // Billing
billingSubscriptions       BillingSubscription[]
billingSubscriptionRequests BillingSubscriptionRequest[]
billingEntitlements        BillingEntitlement[]
billingEntitlementOverrides BillingEntitlementOverride[]

billingInvoices            BillingInvoice[]
billingPayments            BillingPayment[]
billingPaymentAttempts     BillingPaymentAttempt[]
billingPaymentAllocations  BillingPaymentAllocation[]
billingRefunds             BillingRefund[]

billingProviderCustomers   BillingProviderCustomer[]
billingSubscriptionLeases  BillingSubscriptionLease[]

billingEvents              BillingEvent[]
billingAuditLogs           BillingAuditLog[]
supportTicket              SupportTicket[]
platformTenantsProjection  PlatformTenantProjection[]
deviceSyncCheckpoints      DeviceSyncCheckpoint[]

  @@index([userId])
}

model Branch {
  id         String @id

  businessId String

  name       String

  address    String?
  phone      String?

  isActive   Boolean @default(true)
  isDefault  Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  users         User[]
  products      Product[]
  employees                   Employee[]
  employeeInvitations         EmployeeInvitation[]
  employeeCompensations       EmployeeCompensation[]
  employeeCompensationHistory EmployeeCompensationHistory[]
  employeeRequests            EmployeeRequest[]
  inventories   Inventory[]
  snapshots     Snapshot[]
  alerts        Alert[]
  ledgerEntries LedgerEntry[]
  sale          Sale[]
  expenses      Expense[]
  billingSubscriptionLeases BillingSubscriptionLease[]
  

  @@unique([businessId, name])

  @@index([businessId])
}

model User {
  id String @id @default(uuid())

  businessId String?

  branchId         String?
 

  name     String
  email    String @unique
  password String
  googleId String? @unique

  role Role @default(STAFF)

  isActive Boolean @default(true)

  onboardingCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  branch Branch? @relation(fields: [branchId],references: [id],onDelete: SetNull)

  ownedBusinesses Business[] @relation("BusinessOwner")

  passwordResetTokens PasswordResetToken[]

  sessions   Session[]
  employeeProfiles Employee[]


  @@index([businessId])

  @@index([branchId, businessId])
}

model Session {
  id String @id @default(uuid())

  userId String

  refreshToken String @unique
  deviceId String?
  deviceName  String?
  ipAddress String?
  userAgent String?

  lastUsedAt  DateTime  @default(now())

  expiresAt DateTime

  createdAt DateTime @default(now())

  revokedAt  DateTime?

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])

  @@index([expiresAt])
}

model PasswordResetToken {
  id String @id

  userId String

  token String @unique

  expiresAt DateTime

  used Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  @@index([userId])

  @@index([expiresAt])
}
model BillingPlan {
  id          String @id    @default(uuid())
  code        String @unique
  name        String
  description String?

  status      BillingPlanStatus @default(DRAFT)

  displayOrder Int @default(0)
  isFeatured   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions BillingPlanVersion[]

  @@index([status, displayOrder])
}

model BillingPlanVersion {
  id          String @id
  planId      String
  planVersion Int

  priceMinor BigInt
  currency   String @default("NGN")

  billingCycle BillingCycle
  intervalCount Int @default(1)
  trialDays     Int @default(0)

  maxStaff   Int
  maxBranch  Int
  maxProduct Int

  features Json

  publishedAt DateTime?
  createdAt   DateTime @default(now())

  plan BillingPlan @relation(fields: [planId], references: [id], onDelete: Restrict )

  subscriptions BillingSubscription[]
  requests      BillingSubscriptionRequest[]

  @@unique([planId, planVersion])
  @@index([planId])
  @@index([publishedAt])
}

model BillingSubscription {
  id         String @id
  businessId String

  planId      String
  planVersion Int

  status BillingSubscriptionStatus @default(PENDING)

  billingCycle BillingCycle
  currency     String @default("NGN")
  priceMinor   BigInt

  trialStart DateTime?
  trialEnd   DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  gracePeriodEnd DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  activatedAt DateTime?
  cancelledAt DateTime?
  expiredAt   DateTime?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation( fields: [businessId], references: [id], onDelete: Restrict)

  planVersionRecord BillingPlanVersion @relation(fields: [planId, planVersion], references: [planId, planVersion], onDelete: Restrict)

  requests   BillingSubscriptionRequest[]
  entitlements BillingEntitlement[]
  overrides BillingEntitlementOverride[]

  invoices BillingInvoice[]
  payments BillingPayment[]

  providerSubscriptions BillingProviderSubscription[]
  leases BillingSubscriptionLease[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, currentPeriodEnd])
  @@index([planId, planVersion])
  @@index([status, currentPeriodEnd])
}

model BillingSubscriptionRequest {
  id         String @id
  businessId String

  requestedPlanId      String
  requestedPlanVersion Int

  requestType BillingRequestType
  status      BillingRequestStatus @default(PENDING)

  requestedBy String
  reviewedBy  String?

  reviewedAt      DateTime?
  rejectionReason String?

  effectiveAt DateTime?

  subscriptionId String?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  requestedPlanVersionRecord BillingPlanVersion @relation(fields: [requestedPlanId, requestedPlanVersion], references: [planId, planVersion], onDelete: Restrict)

  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([businessId, createdAt])
  @@index([requestedPlanId, requestedPlanVersion])
  @@index([subscriptionId])
}


model BillingEntitlement {
  id             String @id
  businessId     String
  subscriptionId String?

  entitlementKey String
  value          Json

  source BillingEntitlementSource @default(PLAN)
  status BillingRecordStatus @default(ACTIVE)

  validFrom  DateTime
  validUntil DateTime?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  subscription BillingSubscription? @relation( fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([businessId, entitlementKey])
  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([validUntil])
}

model BillingEntitlementOverride {
  id             String @id
  businessId     String
  subscriptionId String?

  entitlementKey String
  value          Json

  status BillingRecordStatus @default(ACTIVE)

  reason    String
  createdBy String

  startsAt  DateTime
  expiresAt DateTime?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation( fields: [businessId], references: [id], onDelete: Restrict )

  subscription BillingSubscription? @relation( fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId, entitlementKey])
  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([expiresAt])
}

model BillingInvoice {
  id             String @id
  businessId     String
  subscriptionId String?

  invoiceNumber String

  status BillingInvoiceStatus @default(DRAFT)

  currency String @default("NGN")

  subtotalMinor  BigInt
  taxMinor       BigInt @default(0)
  discountMinor  BigInt @default(0)
  totalMinor     BigInt

  amountPaidMinor BigInt @default(0)
  amountDueMinor  BigInt

  periodStart DateTime?
  periodEnd   DateTime?

  issuedAt DateTime?
  dueAt    DateTime?
  paidAt   DateTime?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation( fields: [businessId], references: [id], onDelete: Restrict )

  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  items        BillingInvoiceItem[]
  allocations  BillingPaymentAllocation[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([status, dueAt])
}

model BillingInvoiceItem {
  id        String @id
  invoiceId String

  description String

  quantity       Decimal @db.Decimal(18, 6)
  unitPriceMinor BigInt
  lineTotalMinor BigInt

  metadata Json?

  createdAt DateTime @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

model BillingPayment {
  id             String @id
  businessId     String
  subscriptionId String?
  invoiceId      String?

  provider BillingProvider

  providerReference String?

  method BillingPaymentMethod?

  status BillingPaymentStatus @default(INITIATED)

  currency String @default("NGN")

  amountMinor       BigInt
  providerFeeMinor  BigInt @default(0)
  netAmountMinor    BigInt?
  refundedMinor     BigInt @default(0)

  initiatedAt DateTime @default(now())
  confirmedAt DateTime?
  failedAt    DateTime?
  reversedAt  DateTime?
  refundedAt  DateTime?

  failureReason String?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  subscription BillingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  attempts    BillingPaymentAttempt[]
  allocations BillingPaymentAllocation[]
  refunds     BillingRefund[]
  operations  BillingProviderOperation[]

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([subscriptionId])
  @@index([invoiceId])
  @@index([provider, providerReference])
}

model BillingPaymentAttempt {
  id        String @id

  businessId  String
  paymentId String

  provider BillingProvider

  providerReference String?

  attemptNumber Int

  status BillingPaymentAttemptStatus @default(INITIATED)

  failureReason String?

  startedAt   DateTime @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  operations BillingProviderOperation[]

  @@unique([paymentId, attemptNumber])
  @@index([paymentId])
  @@index([provider, providerReference])
  @@index([status])
}

model BillingPaymentAllocation {
  id        String @id
  businessId String 
  paymentId String
  invoiceId String

  amountMinor BigInt

  createdAt DateTime @default(now())

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  invoice BillingInvoice @relation( fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@index([paymentId])
}

model BillingRefund {
  id        String @id
  businessId String
  paymentId String

  providerRefundReference String?

  amountMinor BigInt
  currency    String @default("NGN")

  status BillingRefundStatus @default(PENDING)

  reason String?

  requestedAt DateTime @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  payment BillingPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status])
  @@index([providerRefundReference])
}

model BillingProviderAccount {
  id String @id

  provider BillingProvider

  name String

  environment String @default("LIVE")

  isActive Boolean @default(true)

  // Reference to a secret in environment configuration
  // or a secrets manager. Never store the secret itself here.
  credentialsRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers  BillingProviderCustomer[]
  subscriptions BillingProviderSubscription[]
  webhooks   BillingProviderWebhookEvent[]
  operations BillingProviderOperation[]

  @@unique([provider, name, environment])
  @@index([provider, isActive])
}

model BillingProviderCustomer {
  id String @id

  businessId String
  accountId  String

  providerCustomerId String

  email String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  account BillingProviderAccount @relation( fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, providerCustomerId])
  @@unique([businessId, accountId])
  @@index([businessId])
}

model BillingProviderSubscription {
  id String @id

  subscriptionId String
  accountId      String

  providerSubscriptionId String
  providerCustomerId     String?

  providerPlanCode String?

  status String

  authorizationCodeRef String?

  nextPaymentDate DateTime?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription BillingSubscription @relation( fields: [subscriptionId], references: [id], onDelete: Restrict)

  account BillingProviderAccount @relation( fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, providerSubscriptionId])
  @@index([subscriptionId])
  @@index([providerCustomerId])
  @@index([status])
}

model BillingProviderWebhookEvent {
  id String @id

  accountId String?

  provider BillingProvider

  providerEventId String
  eventType       String

  payload Json

  status BillingWebhookStatus @default(RECEIVED)

  receivedAt  DateTime @default(now())
  processedAt DateTime?

  processingAttempts Int @default(0)

  lastError String?

  account BillingProviderAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
  @@index([provider, eventType])
}

model BillingProviderOperation {
  id String @id

  accountId String

  paymentId String?
  attemptId String?

  provider BillingProvider

  operationType String

  idempotencyKey String

  requestPayload  Json?
  responsePayload Json?

  providerReference String?

  status BillingProviderOperationStatus @default(PENDING)

  attempts Int @default(0)

  lastError String?

  nextAttemptAt DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account BillingProviderAccount @relation( fields: [accountId], references: [id], onDelete: Restrict)

  payment BillingPayment? @relation( fields: [paymentId], references: [id], onDelete: SetNull )

  paymentAttempt BillingPaymentAttempt? @relation( fields: [attemptId], references: [id], onDelete: SetNull)

  @@unique([accountId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([paymentId])
  @@index([attemptId])
  @@index([provider, providerReference])
}

model BillingEvent {
  id String @id

  businessId String?

  aggregateType String
  aggregateId   String
  aggregateVersion Int

  eventType String

  payload Json

  occurredAt DateTime @default(now())

  business Business? @relation( fields: [businessId], references: [id], onDelete: SetNull)

  outboxRecords BillingOutbox[]

  @@unique([aggregateType, aggregateId, aggregateVersion])
  @@index([businessId, occurredAt])
  @@index([aggregateType, aggregateId])
  @@index([eventType, occurredAt])
}

model BillingOutbox {
  id String @id

  eventId String

  destination String @default("BILLING_SYNC")

  status BillingEventStatus @default(PENDING)

  attempts Int @default(0)

  nextAttemptAt DateTime?

  publishedAt DateTime?

  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event BillingEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@unique([eventId, destination])
  @@index([status, nextAttemptAt])
  @@index([status, createdAt])
}

model BillingCommandIdempotency {
  id String @id

  scope String

  idempotencyKey String

  commandType String

  requestHash String

  status BillingCommandStatus @default(PROCESSING)

  resultReference String?

  response Json?

  error String?

  createdAt DateTime @default(now())
  completedAt DateTime?

  @@unique([scope, idempotencyKey])
  @@index([status, createdAt])
}

model BillingSubscriptionLease {
  id String @id

  businessId     String
  subscriptionId String

  branchId String?
  deviceId String

  issuedAt DateTime @default(now())

  expiresAt DateTime

  gracePeriodEnd DateTime?

  status BillingLeaseStatus @default(ACTIVE)

  entitlementSnapshot Json

  signedToken String

  revokedAt DateTime?

  aggregateVersion Int @default(1)
  lastEventId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation( fields: [businessId], references: [id], onDelete: Restrict)

  subscription BillingSubscription @relation( fields: [subscriptionId], references: [id], onDelete: Restrict)

  branch Branch? @relation( fields: [branchId], references: [id], onDelete: Restrict)

  @@index([businessId, status])
  @@index([businessId, branchId, deviceId])
  @@index([subscriptionId])
  @@index([deviceId])
  @@index([expiresAt])
}

model BillingAuditLog {
  id String @id

  businessId String?

  actorUserId String?

  action BillingAuditAction

  entityType String
  entityId   String

  reason String?

  beforeData Json?
  afterData  Json?

  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  business Business? @relation( fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model Product {
  id String

  businessId String

  branchId         String

  sku     String?
  barcode String?

  name String

  imageUrl   String?
  description String?

  category String?

  costPrice Decimal @db.Decimal(18, 6)

  price Decimal @db.Decimal(18, 6)

  reorderLevel Decimal? @db.Decimal(18, 6)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now()) @updatedAt

  deletedAt DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  inventories Inventory[]
  sale          Sale[]

  @@id([id, businessId])

  @@unique([businessId, sku])

  @@unique([businessId, barcode])

  @@index([businessId])

  @@index([name])

