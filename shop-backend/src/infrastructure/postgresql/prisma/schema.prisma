  rolloutPercentage Int @default(0)

  createdByPlatformUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy PlatformUser? @relation( fields: [createdByPlatformUserId], references: [id], onDelete: SetNull)

  overrides PlatformFeatureFlagOverride[]
}

model PlatformFeatureFlagOverride {
  id String @id @default(uuid())

  featureFlagId String

  businessId String

  enabled Boolean

  reason String?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  featureFlag PlatformFeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)

  @@unique([featureFlagId, businessId])
  @@index([businessId])
  @@index([expiresAt])
}



model PlatformIncident {
  id String @id @default(uuid())

  title String
  description String?

  severity PlatformIncidentSeverity
  status PlatformIncidentStatus @default(INVESTIGATING)

  affectedService String?

  startedAt DateTime @default(now())
  identifiedAt DateTime?
  resolvedAt DateTime?

  createdByPlatformUserId String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy PlatformUser? @relation( fields: [createdByPlatformUserId], references: [id], onDelete: SetNull)

  @@index([status, severity])
  @@index([startedAt])
}

model PlatformJobExecution {
  id String @id @default(uuid())

  jobName String

  executionId String @unique

  status String

  startedAt DateTime
  completedAt DateTime?

  durationMs Int?

  attempts Int @default(1)

  error String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([jobName, startedAt])
  @@index([status, startedAt])
}



model PlatformMfaCredential {
  id String @id @default(uuid())

  platformUserId String

  method String

  secretEncrypted String?

  enabledAt DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user PlatformUser @relation( fields: [platformUserId], references: [id], onDelete: Cascade)

  @@index([platformUserId])
}

model PlatformLoginAttempt {
  id String @id @default(uuid())

  email String

  ipAddress String?
  userAgent String?

  successful Boolean

  failureReason String?

  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@index([successful, attemptedAt])
}

